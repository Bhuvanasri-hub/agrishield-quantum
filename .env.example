# IBM Quantum Platform Credentials (for Phase 7 hardware runs)
# Get your API token from: https://quantum.ibm.com/
IBM_QUANTUM_TOKEN=your_ibm_quantum_api_token_here
IBM_QUANTUM_CRN=your_ibm_cloud_instance_crn_here_if_using_cloud

# Copernicus Data Space Ecosystem (CDSE) Credentials (for Phase 6 Sentinel-2 downloads)
# Register free at: https://dataspace.copernicus.eu/
COPERNICUS_CLIENT_ID=your_copernicus_client_id_here
COPERNICUS_CLIENT_SECRET=your_copernicus_client_secret_here
COPERNICUS_USERNAME=your_copernicus_username_here
COPERNICUS_PASSWORD=your_copernicus_password_here

# App settings
AGRISHIELD_ENV=development
